    if ($json -match '(?i)https?://(?:www\.)?modrinth\.com/(?:mod|plugin|datapack)/([^/"?#]+)') {
        return $matches[1]
    }
    if ($json -match '(?i)"(?:modrinthSlug|modrinth_slug|modrinthId|modrinth_id)"\s*:\s*"([^"\\]+)"') {
