function Query-ModrinthByName {
    param([string]$Name)

    if ([string]::IsNullOrWhiteSpace($Name)) { return $null }
    try {
        $query = [uri]::EscapeDataString($Name)
        $search = Invoke-RestMethod -Uri "https://api.modrinth.com/v2/search?query=$query&limit=10" -Method Get -UseBasicParsing -ErrorAction Stop
        if (-not $search.hits) { return $null }

        $normalize = {
            param([string]$Value)
            if ($null -eq $Value) { return "" }
            return (($Value.ToLowerInvariant()) -replace '[^a-z0-9]', '')
        }
        $wanted = & $normalize $Name

        $exact = @($search.hits | Where-Object {
            $_.project_type -eq 'mod' -and (
                $_.title -ieq $Name -or
                (& $normalize $_.title) -eq $wanted -or
                (& $normalize $_.slug) -eq $wanted
            )
        } | Select-Object -First 1)

        if ($exact.Count -gt 0) {
            $hit = $exact[0]
            return @{
                Name = $hit.title
                Slug = $hit.slug
                ProjectId = $hit.project_id
                Downloads = [long]$hit.downloads
                DownloadSource = "Modrinth"
            }
        }
    } catch { }

    return $null
}

