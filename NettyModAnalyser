            if ($null -ne $hit.PrefetchPath -and $hit.PrefetchPath -ne '') {
                Write-Host "       Executable: " -ForegroundColor Gray -NoNewline
                Write-Host "$($hit.PrefetchPath)" -ForegroundColor DarkGray
            }
            if ($null -ne $hit.LastRun -and $hit.LastRun -ne '') {
                Write-Host "       Last run:   " -ForegroundColor Gray -NoNewline
                Write-Host "$($hit.LastRun)" -ForegroundColor DarkGray
            }
        }
        Write-Host ""
    }
    if ($RecentHits.Count -gt 0) {
        Write-Host "  Recent shortcut matches:" -ForegroundColor Magenta
        foreach ($hit in $RecentHits) {
            Write-Host "    • $($hit.FileName)" -ForegroundColor White
            if ($null -ne $hit.TargetPath -and $hit.TargetPath -ne '') {
                Write-Host "       Target:      " -ForegroundColor Gray -NoNewline
                Write-Host "$($hit.TargetPath)" -ForegroundColor DarkGray
            }
            if ($null -ne $hit.LastUsed -and $hit.LastUsed -ne '') {
                Write-Host "       Last used:   " -ForegroundColor Gray -NoNewline
                Write-Host "$($hit.LastUsed)" -ForegroundColor DarkGray
            }
        }
        Write-Host ""
    }
    if ($ArtifactHits.Count -gt 0) {
        Write-Host "  Artifact folder matches:" -ForegroundColor Red
        foreach ($hit in $ArtifactHits) {
            if ($hit.Kind -eq 'Registry') {
                Write-Host "    • FLAGGED: Dqrkis MUICache Entry Found" -ForegroundColor Red
                Write-Host "       Application: $($hit.Application)" -ForegroundColor White
            } elseif ($hit.Kind -eq 'Config') {
                $dayLabel = if ($hit.DaysAgo -eq 1) { 'day' } else { 'days' }
                Write-Host "    • FLAGGED: $($hit.Artifact) — last used $($hit.DaysAgo) $dayLabel ago" -ForegroundColor Red
            } else {
                Write-Host "    • FLAGGED: $($hit.Artifact)" -ForegroundColor Red
            }
            Write-Host "       Path:       $($hit.Path)" -ForegroundColor DarkGray
            if ($hit.Created)  { Write-Host "       Created:    $($hit.Created)" -ForegroundColor DarkGray }
            if ($hit.LastUsed) { Write-Host "       Last used:  $($hit.LastUsed)" -ForegroundColor DarkGray }
            elseif ($hit.Modified) { Write-Host "       Modified:   $($hit.Modified)" -ForegroundColor DarkGray }
        }
        Write-Host ""
    }
    if ($PrefetchHits.Count -eq 0 -and $RecentHits.Count -eq 0 -and $ArtifactHits.Count -eq 0) {
        Write-Host "  No suspicious prefetch, recent link, or artifact folder entries found." -ForegroundColor DarkGray
        Write-Host ""
    }
}

function Write-Rule {
    param([string]$Char = "─", [int]$Width = 76, [ConsoleColor]$Color = "DarkGray")
    Write-Host ($Char * $Width) -ForegroundColor $Color
}

function Write-SectionHeader {
    param(
        [string]$Title,
        [int]$Count,
        [ConsoleColor]$DotColor,
        [ConsoleColor]$CountColor
    )
    Write-Host ""
    Write-Host "  ━━ " -ForegroundColor DarkGray -NoNewline
    Write-Host "●" -ForegroundColor $DotColor -NoNewline
    Write-Host "  $Title  " -ForegroundColor White -NoNewline
    Write-Host "[$Count]" -ForegroundColor $CountColor -NoNewline
    Write-Host "  " -NoNewline
    Write-Host ("━" * 18) -ForegroundColor DarkGray
    Write-Host ""
}

function Write-SuspiciousCard {
    param($Mod)

    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkRed
    Write-Host "  │ " -ForegroundColor DarkRed -NoNewline
    Write-Host " FLAGGED " -ForegroundColor White -BackgroundColor DarkRed -NoNewline
    Write-Host "  " -NoNewline
    Write-Host $Mod.FileName -ForegroundColor White
    Write-Host ("  │ " + ("─" * 66)) -ForegroundColor DarkRed

    if ($Mod.Hidden) {
        Write-Host "  │  MOD IS HIDDEN" -ForegroundColor Yellow
    }

    if ($Mod.Patterns.Count -gt 0) {
        Write-Host "  │" -ForegroundColor DarkRed
        Write-Host "  │  " -ForegroundColor DarkRed -NoNewline
        Write-Host "PATTERNS" -ForegroundColor DarkGray
        foreach ($p in ($Mod.Patterns | Sort-Object)) {
            Write-Host "  │    " -ForegroundColor DarkRed -NoNewline
            Write-Host $p -ForegroundColor Red
        }
    }

    $uniqueStrings = $Mod.Strings | Where-Object { $Mod.Patterns -notcontains $_ } | Sort-Object
    if ($uniqueStrings.Count -gt 0) {
        Write-Host "  │" -ForegroundColor DarkRed
        Write-Host "  │  " -ForegroundColor DarkRed -NoNewline
        Write-Host "STRINGS" -ForegroundColor DarkGray
        foreach ($s in $uniqueStrings) {
            Write-Host "  │    " -ForegroundColor DarkRed -NoNewline
            Write-Host $s -ForegroundColor Magenta
        }
    }

    if ($Mod.Fullwidth -and $Mod.Fullwidth.Count -gt 0) {
        Write-Host "  │" -ForegroundColor DarkRed
        Write-Host "  │  " -ForegroundColor DarkRed -NoNewline
        Write-Host "FULLWIDTH UNICODE" -ForegroundColor DarkGray
        foreach ($fw in ($Mod.Fullwidth | Sort-Object)) {
            Write-Host "  │    " -ForegroundColor DarkRed -NoNewline
            Write-Host "FULLWIDTH: $fw" -ForegroundColor Magenta
        }
    }

    Write-Host "  │" -ForegroundColor DarkRed
    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkRed
    Write-Host ""
}

function Write-InjectionCard {
    param($Mod)

    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkMagenta
    Write-Host "  │ " -ForegroundColor DarkMagenta -NoNewline
    Write-Host " INJECTION " -ForegroundColor White -BackgroundColor DarkMagenta -NoNewline
    Write-Host "  " -NoNewline
    Write-Host $Mod.FileName -ForegroundColor White
    Write-Host ("  │ " + ("─" * 66)) -ForegroundColor DarkMagenta

    if ($Mod.Hidden) {
        Write-Host "  │  MOD IS HIDDEN" -ForegroundColor Yellow
    }

    foreach ($flag in $Mod.Flags) {
        if ($flag -match "^(.+?) — (.+)$") {
            $flagTitle = $matches[1]
            $flagDesc  = $matches[2]
        } else {
            $flagTitle = $flag
            $flagDesc  = ""
        }

        Write-Host "  │" -ForegroundColor DarkMagenta
        Write-Host "  │  " -ForegroundColor DarkMagenta -NoNewline
        Write-Host "◉ " -ForegroundColor Magenta -NoNewline
        Write-Host $flagTitle -ForegroundColor White

        if ($flagDesc -ne "") {
            Write-Host "  │    " -ForegroundColor DarkMagenta -NoNewline
            Write-Host $flagDesc -ForegroundColor Gray
        }
    }

    Write-Host "  │" -ForegroundColor DarkMagenta
    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkMagenta
    Write-Host ""
}

function Write-ObfuscationCard {
    param($Mod)

    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkMagenta
    Write-Host "  │ " -ForegroundColor DarkMagenta -NoNewline
    Write-Host " OBFUSCATED " -ForegroundColor White -BackgroundColor DarkMagenta -NoNewline
    Write-Host "  " -NoNewline
    Write-Host $Mod.FileName -ForegroundColor White
    Write-Host ("  │ " + ("─" * 66)) -ForegroundColor DarkMagenta

    if ($Mod.Hidden) {
        Write-Host "  │  MOD IS HIDDEN" -ForegroundColor Yellow
    }

    foreach ($flag in $Mod.Flags) {
        if ($flag -match "^(.+?) — (.+)$") {
            $flagTitle = $matches[1]
            $flagDesc  = $matches[2]
        } else {
            $flagTitle = $flag
            $flagDesc  = ""
        }

        Write-Host "  │" -ForegroundColor DarkMagenta
        Write-Host "  │  " -ForegroundColor DarkMagenta -NoNewline
        Write-Host "⚑ " -ForegroundColor Magenta -NoNewline
        Write-Host $flagTitle -ForegroundColor White

        if ($flagDesc -ne "") {
            Write-Host "  │    " -ForegroundColor DarkMagenta -NoNewline
            Write-Host $flagDesc -ForegroundColor Gray
        }
    }

    Write-Host "  │" -ForegroundColor DarkMagenta
    Write-Host ("  " + ("─" * 70)) -ForegroundColor DarkMagenta
    Write-Host ""
}

$verifiedMods    = @()
$unknownMods     = @()
$suspiciousMods  = @()
$bypassMods      = @()
$obfuscatedMods  = @()

try {
    $jarFiles = @(Get-ChildItem -LiteralPath $modsPath -Filter *.jar -File -Force -ErrorAction Stop)
} catch {
    Write-Host "❌ Error accessing directory: $_" -ForegroundColor Red
    Write-Host "Press any key to exit..." -ForegroundColor Gray
    $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    exit 1
}

if ($jarFiles.Count -eq 0) {
    Write-Host "⚠️  No JAR files found in: $modsPath" -ForegroundColor Yellow
    Write-Host "Press any key to exit..." -ForegroundColor Gray
    $null = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    exit 0
}

$fileWord    = if ($jarFiles.Count -eq 1) { "file" } else { "files" }
Write-Host "🔍 Found $($jarFiles.Count) JAR $fileWord to analyze" -ForegroundColor Cyan
Write-Host

$spinnerFrames = @("⣾","⣽","⣻","⢿","⡿","⣟","⣯","⣷")
$totalFiles    = $jarFiles.Count
$idx           = 0

Write-Host "🔍 Pass 1 — Hash verification (Modrinth + Megabase)..." -ForegroundColor Cyan

foreach ($jar in $jarFiles) {
    $idx++
    $spinner = $spinnerFrames[$idx % $spinnerFrames.Length]
    Write-Host "`r[$spinner] Verifying: $idx/$totalFiles - $($jar.Name)" -ForegroundColor DarkCyan -NoNewline

    $hash = Get-FileSHA1 -Path $jar.FullName
    $isHidden = Test-IsHiddenPath -File $jar -RootPath $modsPath
    $originUrl = Get-DownloadOriginUrl -Path $jar.FullName

    if ($hash) {
        # Priority 1: exact Modrinth hash match. If a project exists on both platforms,
        # Modrinth is always preferred for the displayed download count.
        $modrinthData = Query-Modrinth -Hash $hash
        if ($modrinthData.Slug) {
            $modrinthWhitelistedSlugs = @("viafabricplus", "viafabricversion")
            $isModrinthWhitelisted = $modrinthWhitelistedSlugs -contains $modrinthData.Slug.ToLower()

            $verifiedMods += [PSCustomObject]@{
                ModName = $modrinthData.Name
                FileName = $jar.Name
                FilePath = $jar.FullName
                Hidden = $isHidden
                Downloads = [long]$modrinthData.Downloads
                DownloadSource = "Modrinth"
                ModrinthWhitelisted = $isModrinthWhitelisted
            }
            continue
        }

        $megabaseData = Query-Megabase -Hash $hash
        if ($megabaseData.name) {
            $preferredDownloads = $null

            # Megabase may know a Modrinth project even when this exact file hash is not there.
            # Use an explicit Modrinth id/slug first, otherwise only accept a strong exact-name match.
            $modrinthIdentifier = Get-ModrinthIdentifierFromData -Data $megabaseData
            if ($modrinthIdentifier) {
                $preferredDownloads = Query-ModrinthProject -IdOrSlug $modrinthIdentifier
            }
            if (-not $preferredDownloads) {
                $preferredDownloads = Query-ModrinthByName -Name $megabaseData.Name
            }

            # If no Modrinth project exists, fall back to CurseForge.
            if (-not $preferredDownloads) {
                $curseForgePath = Get-CurseForgeProjectPathFromData -Data $megabaseData
                if (-not $curseForgePath -and $originUrl) {
                    $curseForgePath = Normalize-CurseForgeProjectPath -Value $originUrl
                    if ($originUrl -notmatch '(?i)curseforge\.com') { $curseForgePath = "" }
                }
                if ($curseForgePath) {
                    $preferredDownloads = Query-CurseForgeByProjectPath -ProjectPath $curseForgePath
                }
            }

            # Last fallback: use a platform-specific download total if Megabase already returned one.
            if (-not $preferredDownloads) {
                $preferredDownloads = Get-MegabaseStoredDownloadInfo -Data $megabaseData
            }

            $downloadCount = -1
            $downloadSource = ""
            if ($preferredDownloads) {
                $downloadCount = [long]$preferredDownloads.Downloads
                $downloadSource = [string]$preferredDownloads.DownloadSource
            }

            $verifiedMods += [PSCustomObject]@{
                ModName = $megabaseData.Name
                FileName = $jar.Name
                FilePath = $jar.FullName
                Hidden = $isHidden
                Downloads = $downloadCount
                DownloadSource = $downloadSource
                ModrinthWhitelisted = $false
            }
            continue
        }
    }

    $src = Get-DownloadSource $jar.FullName
    $unknownMods += [PSCustomObject]@{
        FileName = $jar.Name
        FilePath = $jar.FullName
        DownloadSource = $src
        Hidden = $isHidden
    }
}

Write-Host "`r$(' ' * 100)`r" -NoNewline

$modWord = if ($totalFiles -eq 1) { "mod" } else { "mods" }
Write-Host "🔬 Pass 2 — Deep-scanning all $totalFiles $modWord..." -ForegroundColor Cyan
$idx = 0

foreach ($jar in $jarFiles) {
    $idx++
    $spinner = $spinnerFrames[$idx % $spinnerFrames.Length]
    Write-Host "`r[$spinner] Scanning: $idx/$totalFiles - $($jar.Name)" -ForegroundColor DarkCyan -NoNewline

    $verifiedEntry = $verifiedMods | Where-Object { $_.FileName -eq $jar.Name } | Select-Object -First 1
    if ($verifiedEntry -and $verifiedEntry.ModrinthWhitelisted -eq $true) {
        continue
    }

    $result = Invoke-ModScan -FilePath $jar.FullName

    if ($result.Patterns.Count -gt 0 -or $result.Strings.Count -gt 0 -or $result.Fullwidth.Count -gt 0) {
        $suspiciousMods += [PSCustomObject]@{
            FileName  = $jar.Name
            Patterns  = $result.Patterns
            Strings   = $result.Strings
            Fullwidth = $result.Fullwidth
            Hidden    = (Test-IsHiddenPath -File $jar -RootPath $modsPath)
        }
        $verifiedMods = $verifiedMods | Where-Object { $_.FileName -ne $jar.Name }
    }
}

Write-Host "`r$(' ' * 100)`r" -NoNewline

Write-Host "🛡️  Pass 3 — Bypass/injection scan on all $totalFiles $modWord..." -ForegroundColor Magenta
$idx = 0

foreach ($jar in $jarFiles) {
    $idx++
    $spinner = $spinnerFrames[$idx % $spinnerFrames.Length]
    Write-Host "`r[$spinner] Bypass scan: $idx/$totalFiles - $($jar.Name)" -ForegroundColor Magenta -NoNewline

    $verifiedEntry = $verifiedMods | Where-Object { $_.FileName -eq $jar.Name } | Select-Object -First 1
    if ($verifiedEntry -and $verifiedEntry.ModrinthWhitelisted -eq $true) {
        continue
    }

    $bypassFlags = Invoke-BypassScan -FilePath $jar.FullName

    if ($bypassFlags.Count -gt 0) {
        $bypassMods += [PSCustomObject]@{
            FileName = $jar.Name
            Flags    = $bypassFlags
            Hidden   = (Test-IsHiddenPath -File $jar -RootPath $modsPath)
        }
        $verifiedMods = $verifiedMods | Where-Object { $_.FileName -ne $jar.Name }
        $unknownMods  = $unknownMods  | Where-Object { $_.FileName -ne $jar.Name }
    }
}

Write-Host "`r$(' ' * 100)`r" -NoNewline

Write-Host "🔎 Pass 4 — Obfuscation analysis on all $totalFiles $modWord..." -ForegroundColor DarkMagenta
$idx = 0

foreach ($jar in $jarFiles) {
    $idx++
    $spinner = $spinnerFrames[$idx % $spinnerFrames.Length]
    Write-Host "`r[$spinner] Obf scan: $idx/$totalFiles - $($jar.Name)" -ForegroundColor DarkMagenta -NoNewline

    $obfFlags = Invoke-ObfuscationScan -FilePath $jar.FullName

    if ($obfFlags.Count -gt 0) {
        $alreadyFlagged = ($suspiciousMods | Where-Object { $_.FileName -eq $jar.Name }).Count -gt 0 -or
                          ($bypassMods     | Where-Object { $_.FileName -eq $jar.Name }).Count -gt 0
        if (-not $alreadyFlagged) {
            $obfuscatedMods += [PSCustomObject]@{
                FileName = $jar.Name
                Flags    = $obfFlags
                Hidden   = (Test-IsHiddenPath -File $jar -RootPath $modsPath)
            }
            $verifiedMods = $verifiedMods | Where-Object { $_.FileName -ne $jar.Name }
        }
    }
}

Write-Host "`r$(' ' * 100)`r" -NoNewline

$jvmFlags = @()
$jvmArgumentResults = @()
Write-Host "⚡ Pass 5 — Scanning JVM arguments, agents and injections..." -ForegroundColor Cyan
$jvmArgumentResults = @(Invoke-JvmArgumentInspector)
