function Get-DownloadOriginUrl {
    param([string]$Path)

    try {
        $zoneData = Get-Content -Raw -Stream Zone.Identifier $Path -ErrorAction SilentlyContinue
        if (-not $zoneData) { return "" }

        $urls = @()
        foreach ($m in [regex]::Matches($zoneData, '(?im)^(?:HostUrl|ReferrerUrl)=(.+)$')) {
            $candidate = $m.Groups[1].Value.Trim()
            if ($candidate) { $urls += $candidate }
        }

        foreach ($url in $urls) {
            if ($url -match '(?i)modrinth\.com|curseforge\.com') { return $url }
        }
        if ($urls.Count -gt 0) { return $urls[0] }
    } catch { }

    return ""
}

