        }
    }

    return $null
}

$fullwidthRegex = [regex]::new(
    "[\uFF21-\uFF3A\uFF41-\uFF5A\uFF10-\uFF19]{2,}",
    [System.Text.RegularExpressions.RegexOptions]::Compiled
)


# --- Recursive nested-JAR scanner ---
# Fabric mods commonly bundle dependencies under META-INF/jars.  Scan those JARs
# recursively so a second/third nested layer is not skipped.  Limits prevent
# malformed archives / zip bombs from consuming unlimited memory.
function Get-RecursiveJarSnapshot {
    param(
        [string]$FilePath,
        [int]$MaxDepth = 3,
        [long]$MaxNestedJarBytes = 33554432,      # 32 MiB per nested JAR
        [long]$MaxTotalNestedBytes = 134217728,   # 128 MiB expanded nested-JAR budget
        [int]$MaxNestedArchives = 64,
        [long]$MaxEntryBytes = 8388608            # 8 MiB for class/json/manifest content
    )

    $entries = [System.Collections.Generic.List[object]]::new()
    $nestedJars = [System.Collections.Generic.List[object]]::new()
    $warnings = [System.Collections.Generic.List[string]]::new()
    $state = [PSCustomObject]@{
        NestedBytes    = [long]0
        NestedArchives = 0
    }

    function Add-ArchiveToSnapshot {
        param(
            [System.IO.Compression.ZipArchive]$Archive,
            [int]$Depth,
            [string]$Chain
        )

        foreach ($entry in $Archive.Entries) {
            $name = $entry.FullName
            $isNestedJar = ($name -match '(?i)^META-INF/jars/.+\.jar$')
            $needsBytes = (
                $name -match '(?i)\.(class|json)$' -or
                $name -match '(?i)(^|/)META-INF/MANIFEST\.MF$'
            )

            $bytes = $null
            if ($needsBytes -and $entry.Length -le $MaxEntryBytes) {
                try {
                    $st = $entry.Open()
                    $ms = New-Object System.IO.MemoryStream
                    $st.CopyTo($ms)
                    $st.Close()
                    $bytes = $ms.ToArray()
                    $ms.Dispose()
                } catch { }
            }

            $entries.Add([PSCustomObject]@{
                FullName = $name
                Depth    = $Depth
                Chain    = $Chain
                Length   = [long]$entry.Length
                Bytes    = $bytes
            })

            if (-not $isNestedJar) { continue }

            $childDepth = $Depth + 1
            $jarName = [System.IO.Path]::GetFileName($name)
            $nestedJars.Add([PSCustomObject]@{
                Name        = $jarName
                FullName    = $name
                Depth       = $childDepth
                ParentChain = $Chain
                Length      = [long]$entry.Length
            })

            # Record the existence of deeper JARs, but only extract through MaxDepth.
            if ($childDepth -gt $MaxDepth) {
                $warnings.Add("Nested depth limit reached: $jarName (depth $childDepth)")
                continue
            }
            if ($state.NestedArchives -ge $MaxNestedArchives) {
                $warnings.Add("Nested archive limit reached before: $jarName")
                continue
            }
            if ($entry.Length -gt $MaxNestedJarBytes) {
                $warnings.Add("Nested JAR too large to expand safely: $jarName")
                continue
            }
            if (($state.NestedBytes + [long]$entry.Length) -gt $MaxTotalNestedBytes) {
                $warnings.Add("Nested JAR byte budget reached before: $jarName")
                continue
            }

            try {
                $ns = $entry.Open()
                $nestedMs = New-Object System.IO.MemoryStream
                $ns.CopyTo($nestedMs)
                $ns.Close()
                $nestedMs.Position = 0

                $state.NestedBytes += [long]$entry.Length
                $state.NestedArchives++

                $childChain = if ([string]::IsNullOrWhiteSpace($Chain)) {
                    $jarName
                } else {
                    "$Chain -> $jarName"
                }

                $nestedZip = [System.IO.Compression.ZipArchive]::new(
                    $nestedMs,
                    [System.IO.Compression.ZipArchiveMode]::Read
                )
                try {
                    Add-ArchiveToSnapshot -Archive $nestedZip -Depth $childDepth -Chain $childChain
                } finally {
                    try { $nestedZip.Dispose() } catch { }
                    try { $nestedMs.Dispose() } catch { }
                }
            } catch {
                $warnings.Add("Could not open nested JAR: $jarName")
            }
        }
    }

    $root = $null
    try {
        $root = [System.IO.Compression.ZipFile]::OpenRead($FilePath)
        Add-ArchiveToSnapshot -Archive $root -Depth 0 -Chain ([System.IO.Path]::GetFileName($FilePath))
    } catch { }
    finally {
        if ($root) { try { $root.Dispose() } catch { } }
    }

    return [PSCustomObject]@{
        Entries    = $entries
        NestedJars = $nestedJars
        Warnings   = $warnings
        MaxDepth   = $MaxDepth
    }
}

function Invoke-ModScan {
    param([string]$FilePath)

    $foundPatterns  = [System.Collections.Generic.HashSet[string]]::new()
    $foundStrings   = [System.Collections.Generic.HashSet[string]]::new()
    $foundFullwidth = [System.Collections.Generic.HashSet[string]]::new()

    try {
        $snapshot = Get-RecursiveJarSnapshot -FilePath $FilePath -MaxDepth 3

        foreach ($entry in $snapshot.Entries) {
            foreach ($m in $patternRegex.Matches($entry.FullName)) {
                [void]$foundPatterns.Add($m.Value)
            }

            $name = $entry.FullName
            if (($name -match '(?i)\.(class|json)$' -or $name -match '(?i)MANIFEST\.MF$') -and $entry.Bytes) {
                try {
                    $bytes = [byte[]]$entry.Bytes
                    $ascii = [System.Text.Encoding]::ASCII.GetString($bytes)
                    $utf8  = [System.Text.Encoding]::UTF8.GetString($bytes)

                    foreach ($m in $patternRegex.Matches($ascii)) {
                        [void]$foundPatterns.Add($m.Value)
                    }

                    foreach ($s in $cheatStringSet) {
                        if ($ascii.Contains($s)) { [void]$foundStrings.Add($s); continue }
                        if ($utf8.Contains($s))  { [void]$foundStrings.Add($s) }
                    }

                    foreach ($m in $fullwidthRegex.Matches($utf8)) {
                        [void]$foundFullwidth.Add($m.Value)
                    }
                } catch { }
            }
        }
    } catch { }

    $fwCheatPool = @($script:cheatStrings | Where-Object {
        $_ -cmatch "[\uFF21-\uFF3A\uFF41-\uFF5A\uFF10-\uFF19]"
    })
    $resolvedFullwidth = [System.Collections.Generic.HashSet[string]]::new()
    foreach ($fw in @($foundFullwidth)) {
        if ($fw.Length -lt 3) { continue }
        $bestMatch = $null
        foreach ($cs in $fwCheatPool) {
            if ($cs.Contains($fw)) {
                if ($null -eq $bestMatch -or $cs.Length -lt $bestMatch.Length) {
                    $bestMatch = $cs
                }
            }
        }
        if ($null -ne $bestMatch) {
            [void]$resolvedFullwidth.Add($bestMatch)
        } elseif ($fw.Length -ge 6) {
            [void]$resolvedFullwidth.Add($fw)
        }
    }
    $resolved = @($resolvedFullwidth)
    $finalFullwidth = [System.Collections.Generic.HashSet[string]]::new()
    foreach ($fw in $resolved) {
        $isRedundant = $false
        foreach ($other in $resolved) {
            if ($fw.Length -lt $other.Length -and $other.Contains($fw)) {
                $isRedundant = $true; break
            }
        }
        if (-not $isRedundant) { [void]$finalFullwidth.Add($fw) }
    }

    return @{ Patterns = $foundPatterns; Strings = $foundStrings; Fullwidth = $finalFullwidth }
}


function Invoke-ObfuscationScan {
    param([string]$FilePath)

    $flags = [System.Collections.Generic.List[string]]::new()

    try {
        $snapshot = Get-RecursiveJarSnapshot -FilePath $FilePath -MaxDepth 3

        $totalClass    = 0
        $numericCount  = 0
        $unicodeCount  = 0
        $fullwidthCount= 0
        $japaneseCount = 0
        $singleLetterCount = 0
        $twoLetterCount    = 0
        $gibberishCount    = 0
        $noVowelCount      = 0
        $confusionCount    = 0
        $singleCharPkg     = 0
        $contentSample     = [System.Text.StringBuilder]::new()
        $sampleSize        = 0

        $cheatObfuscators = @{
            "Skidfuscator"   = @("dev/skidfuscator", "Skidfuscator", "skidfuscator.dev")
            "Paramorphism"   = @("Paramorphism", "paramorphism-", "dev/paramorphism")
            "Radon"          = @("ItzSomebody/Radon", "me/itzsomebody/radon", "Radon Obfuscator")
            "Caesium"        = @("sim0n/Caesium", "Caesium Obfuscator", "dev/sim0n/caesium")
            "Bozar"          = @("vimasig/Bozar", "Bozar Obfuscator", "com/bozar")
            "Branchlock"     = @("Branchlock", "branchlock.dev")
            "Binscure"       = @("Binscure", "com/binscure")
            "SuperBlaubeere" = @("superblaubeere", "superblaubeere27")
            "Qprotect"       = @("Qprotect", "QProtect", "mdma.dev/qprotect")
            "Zelix"          = @("ZKMFLOW", "ZKM", "ZelixKlassMaster", "com/zelix")
            "Stringer"       = @("StringerJavaObfuscator", "com/licel/stringer")
            "Scuti"          = @("ScutiObf", "scuti.obf")
            "Smoke"          = @("SmokeObf", "smoke.obf")
        }

        foreach ($entry in $snapshot.Entries) {
            $name = $entry.FullName
            if ($name -notmatch '(?i)\.class$') { continue }

            $totalClass++
            $className = [System.IO.Path]::GetFileNameWithoutExtension(($name -split "/")[-1])

            if ($className -match "^\d+$")                          { $numericCount++ }
            if ($className -match "[^\x00-\x7F]")                   { $unicodeCount++ }
            if ($className -match "[\uFF21-\uFF3A\uFF41-\uFF5A\uFF10-\uFF19]") { $fullwidthCount++ }
            if ($className -match "[\u3040-\u309F\u30A0-\u30FF]")  { $japaneseCount++ }
            if ($className -match "^[a-zA-Z]$")                     { $singleLetterCount++ }
            if ($className -match "^[a-zA-Z]{2}$")                  { $twoLetterCount++ }
            if ($className -match "^[Il1O0]+$" -or $className -match "^[_]+$") { $confusionCount++ }

            if ($className.Length -ge 3 -and $className.Length -le 8 -and $className -match "^[a-zA-Z]+$") {
                $vowels = ($className.ToCharArray() | Where-Object { $_ -match "[aeiouAEIOU]" }).Count
                if ($vowels -eq 0) { $noVowelCount++ }
                $hasCluster = $className -match "[bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ]{3,}"
                if ($hasCluster -and ($vowels / $className.Length) -lt 0.3) { $gibberishCount++ }
            }

            $segs = ($name -replace "\.class$", "") -split "/"
            if ($segs.Count -gt 1) {
                foreach ($seg in $segs[0..($segs.Count - 2)]) {
                    if ($seg.Length -eq 1) { $singleCharPkg++ }
                }
            }

            if ($sampleSize -lt 150000 -and $entry.Length -lt 100000 -and $entry.Length -gt 100 -and $entry.Bytes) {
                try {
                    $ascii = [System.Text.Encoding]::ASCII.GetString([byte[]]$entry.Bytes)
                    [void]$contentSample.Append($ascii)
                    $sampleSize += $ascii.Length
                } catch { }
            }
        }

        if ($totalClass -lt 5) { return $flags }

        $pct = { param($n) [math]::Round(($n / $totalClass) * 100) }

        $numPct   = & $pct $numericCount
        $uniPct   = & $pct $unicodeCount
        $fwPct    = & $pct $fullwidthCount
        $jpPct    = & $pct $japaneseCount
        $s1Pct    = & $pct $singleLetterCount
        $s2Pct    = & $pct $twoLetterCount
        $gibPct   = & $pct $gibberishCount
        $novPct   = & $pct $noVowelCount
        $confPct  = & $pct $confusionCount

        if ($numPct   -ge 20) { $flags.Add("Numeric class names — $numPct% of classes have numeric-only names") }
        if ($uniPct   -ge 10) { $flags.Add("Unicode class names — $uniPct% of classes use non-ASCII characters") }
        if ($fwPct    -gt  0) { $flags.Add("Fullwidth Unicode class names — $fwPct% use ａｂｃ/ＡＢＣ/０１２ chars ($fullwidthCount classes)") }
        if ($jpPct    -gt  0) { $flags.Add("Japanese obfuscation — $jpPct% use hiragana/katakana class names ($japaneseCount classes)") }
        if ($s1Pct    -ge 15) { $flags.Add("Single-letter class names — $s1Pct% ($singleLetterCount classes)") }
        if ($s2Pct    -ge 20) { $flags.Add("Two-letter class names — $s2Pct% ($twoLetterCount classes)") }
        if ($gibPct   -ge  5) { $flags.Add("Gibberish class names — $gibPct% have no vowels / consonant clusters ($gibberishCount classes)") }
        if ($novPct   -ge  8) { $flags.Add("No-vowel class names — $novPct% ($noVowelCount classes)") }
        if ($confPct  -ge  3) { $flags.Add("Confusion-char names (Il1O0/_) — $confPct% ($confusionCount classes)") }
        if ($singleCharPkg -ge 6) { $flags.Add("Single-char package paths — $singleCharPkg path segments like a/b/c") }

        $fwStringMatches = [regex]::Matches($contentSample.ToString(), "[\uFF21-\uFF3A\uFF41-\uFF5A\uFF10-\uFF19]{2,}")
        if ($fwStringMatches.Count -gt 0) {
            $examples = ($fwStringMatches | Select-Object -First 3 | ForEach-Object { $_.Value }) -join ", "
            $flags.Add("Fullwidth strings in class content — $($fwStringMatches.Count) occurrences (e.g. $examples)")
        }

        $sampleStr = $contentSample.ToString()
        foreach ($obfName in $cheatObfuscators.Keys) {
            foreach ($pat in $cheatObfuscators[$obfName]) {
                if ($sampleStr.Contains($pat)) {
                    $flags.Add("Known cheat obfuscator detected — $obfName (matched: $pat)")
                    break
                }
            }
        }

    } catch { }

    return $flags
}


function Invoke-BypassScan {
    param([string]$FilePath)

    $flags = [System.Collections.Generic.List[string]]::new()

    $mavenPrefixes = @(
        "com_","org_","net_","io_","dev_","gs_","xyz_",
        "app_","me_","tv_","uk_","be_","fr_","de_"
    )

    function Test-SuspiciousJarName {
        param([string]$JarName)
        $base = [System.IO.Path]::GetFileNameWithoutExtension($JarName)
        if ($base -match '\d')                                          { return $false }
        foreach ($pfx in $mavenPrefixes) {
            if ($base.ToLower().StartsWith($pfx))                       { return $false }
        }
        if ($base.Length -gt 20)                                        { return $false }
        return $true
    }

    try {
        $snapshot = Get-RecursiveJarSnapshot -FilePath $FilePath -MaxDepth 3
        $nestedJars   = @($snapshot.NestedJars)
        $directNested = @($nestedJars | Where-Object { $_.Depth -eq 1 })
        $outerClasses = @($snapshot.Entries | Where-Object { $_.Depth -eq 0 -and $_.FullName -match '(?i)\.class$' })

        $seenNestedNames = @{}
        foreach ($nj in $nestedJars) {
            $njBase = [System.IO.Path]::GetFileName($nj.FullName)
            if ((Test-SuspiciousJarName -JarName $njBase) -and -not $seenNestedNames.ContainsKey($njBase)) {
                $seenNestedNames[$njBase] = $true
                $flags.Add("Suspicious nested JAR — no version, unknown dependency: $njBase")
            }
        }

        if ($directNested.Count -eq 1 -and $outerClasses.Count -lt 3) {
            $njName = [System.IO.Path]::GetFileName(($directNested | Select-Object -First 1).FullName)
            $flags.Add("Hollow shell — only $($outerClasses.Count) own class(es), wraps: $njName")
        }

        $outerModId = ""
        $fmje = $snapshot.Entries | Where-Object {
            $_.Depth -eq 0 -and $_.FullName -eq 'fabric.mod.json' -and $_.Bytes
        } | Select-Object -First 1
        if ($fmje) {
            try {
                $t = [System.Text.Encoding]::UTF8.GetString([byte[]]$fmje.Bytes)
                if ($t -match '"id"\s*:\s*"([^"]+)"') { $outerModId = $matches[1] }
            } catch { }
        }

        $runtimeExecFound          = $false
        $httpDownloadFound         = $false
        $httpExfilFound            = $false
        $obfuscatedCount           = 0
        $numericClassCount         = 0
        $unicodeClassCount         = 0
        $totalClassCount           = 0

        foreach ($entry in $snapshot.Entries) {
            $name = $entry.FullName
            if ($name -notmatch '(?i)\.class$') { continue }

            $totalClassCount++
            $className = [System.IO.Path]::GetFileNameWithoutExtension(($name -split "/")[-1])

            if ($className -match "^\d+$") { $numericClassCount++ }
            if ($className -match "[^\x00-\x7F]") { $unicodeClassCount++ }

            $segs = ($name -replace "\.class$","") -split "/"
            $consecutiveSingle = 0
            $maxConsecutive    = 0
            foreach ($seg in $segs) {
                if ($seg.Length -eq 1) {
                    $consecutiveSingle++
                    if ($consecutiveSingle -gt $maxConsecutive) { $maxConsecutive = $consecutiveSingle }
                } else {
                    $consecutiveSingle = 0
                }
            }
            if ($maxConsecutive -ge 3) { $obfuscatedCount++ }

            if (-not $entry.Bytes) { continue }
            try {
                $ct = [System.Text.Encoding]::ASCII.GetString([byte[]]$entry.Bytes)

                if ($ct -match "java/lang/Runtime" -and $ct -match "getRuntime" -and $ct -match "exec") {
                    $runtimeExecFound = $true
                }

                if ($ct -match "openConnection" -and $ct -match "HttpURLConnection" -and $ct -match "FileOutputStream") {
                    $httpDownloadFound = $true
                }

                if ($ct -match "openConnection" -and $ct -match "setDoOutput" -and $ct -match "getOutputStream" -and $ct -match "getProperty") {
                    $httpExfilFound = $true
                }

            } catch { }
        }

        $obfPct = if ($totalClassCount -ge 10) { [math]::Round(($obfuscatedCount   / $totalClassCount) * 100) } else { 0 }
        $numPct = if ($totalClassCount -ge 5)  { [math]::Round(($numericClassCount / $totalClassCount) * 100) } else { 0 }
        $uniPct = if ($totalClassCount -ge 5)  { [math]::Round(($unicodeClassCount / $totalClassCount) * 100) } else { 0 }

        if ($runtimeExecFound -and $obfPct -ge 25) {
            $flags.Add("Runtime.exec() in obfuscated code — can run arbitrary OS commands")
        }
        if ($httpDownloadFound) {
            $flags.Add("HTTP file download — fetches and writes files from a remote server at runtime")
        }
        if ($httpExfilFound) {
            $flags.Add("HTTP POST exfiltration — sends system data to an external server")
        }
        if ($totalClassCount -ge 10 -and $obfPct -ge 25) {
            $flags.Add("Heavy obfuscation — $obfPct% of classes use single-letter path segments (a/b/c style)")
        }
        if ($numPct -ge 20) {
            $flags.Add("Numeric class names — $numPct% of classes have numeric-only names (e.g. 1234.class)")
        }
        if ($uniPct -ge 10) {
            $flags.Add("Unicode class names — $uniPct% of classes use non-ASCII characters")
        }

        $knownLegitModIds = @(
            "vmp-fabric","vmp","lithium","sodium","iris","fabric-api",
            "modmenu","ferrite-core","lazydfu","starlight","entityculling",
            "memoryleakfix","krypton","c2me-fabric","smoothboot-fabric",
            "immediatelyfast","noisium","threadtweak"
        )
        $dangerCount = ($flags | Where-Object {
            $_ -match "Runtime\.exec|HTTP file download|HTTP POST|Heavy obfuscation|Suspicious nested JAR"
        }).Count
        if ($outerModId -and ($knownLegitModIds -contains $outerModId) -and $dangerCount -gt 0) {
            $flags.Add("Fake mod identity — claims to be '$outerModId' but contains dangerous code")
        }

    } catch { }

    return $flags
}


function Get-RelevantJvmArgs {
    param([string]$CommandLine)

    if ([string]::IsNullOrWhiteSpace($CommandLine)) { return @() }

    $relevantPrefixes = @(
        '-javaagent',
        '-Dfabric.addMods',
        '-Dloader.addMods',
        '-Dfabric.gameJarPath',
        '-Dloader.gameJarPath',
        '-Djava.library.path',
        '-Djna.boot.library.path',
        '-Djdk.attach.allowAttachSelf',
        '--tweakClass',
        '--launchTarget',
        '-agentpath:',
        '-agentlib:jdwp',
        '-Xbootclasspath/p:',
        '-Xbootclasspath/a:'
    )

    # Splitting before the next dash keeps values containing spaces together in most
    # Minecraft launcher command lines, including quoted -D paths.
    $parts = @($CommandLine -split ' (?=-)')
    $result = [System.Collections.Generic.List[string]]::new()
    foreach ($part in $parts) {
        $clean = $part.Trim()
        foreach ($prefix in $relevantPrefixes) {
            if ($clean.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)) {
                $result.Add($clean)
                break
            }
        }
    }
    return $result
}

function Get-JvmArgSeverity {
    param([string]$Arg)
    if ($Arg -like '-javaagent*' -or $Arg -like '-agentpath:*' -or
        $Arg -like '-Djdk.attach.allowAttachSelf*' -or $Arg -like '-agentlib:jdwp*' -or
        $Arg -like '-Xbootclasspath/p:*') { return 'Red' }
    if ($Arg -like '-Dfabric.addMods*' -or $Arg -like '-Dloader.addMods*' -or
        $Arg -like '-Dfabric.gameJarPath*' -or $Arg -like '-Dloader.gameJarPath*' -or
        $Arg -like '--tweakClass*' -or $Arg -like '--launchTarget*' -or
        $Arg -like '-Xbootclasspath/a:*') { return 'Magenta' }
    if ($Arg -like '-Djava.library.path*' -or $Arg -like '-Djna.boot.library.path*') { return 'Cyan' }
    return 'Gray'
}

function Invoke-JvmArgumentInspector {
    $results = [System.Collections.Generic.List[psobject]]::new()
    try {
        $processes = @(Get-CimInstance Win32_Process -Filter "name = 'javaw.exe' OR name = 'java.exe'" -ErrorAction SilentlyContinue)
        foreach ($proc in $processes) {
            $args = @(Get-RelevantJvmArgs -CommandLine $proc.CommandLine)
            $results.Add([PSCustomObject]@{
                ProcessId   = $proc.ProcessId
                Name        = $proc.Name
                CommandLine = $proc.CommandLine
                Arguments   = $args
            })
        }
    } catch { }
    return $results
}

function Write-JvmArgumentInspectorReport {
    param($ProcessResults)
    $ProcessResults = @($ProcessResults | Where-Object { $_ -ne $null })
    $flagCount = 0
    foreach ($p in $ProcessResults) { $flagCount += @($p.Arguments).Count }

    Write-SectionHeader -Title 'JVM ARGUMENT INSPECTOR' -Count $flagCount -DotColor Cyan -CountColor Cyan
    if ($ProcessResults.Count -eq 0) {
        Write-Host '  No javaw.exe / java.exe process found.' -ForegroundColor DarkGray
        Write-Host ''
        return
    }

    foreach ($proc in $ProcessResults) {
        Write-Host "  PID $($proc.ProcessId) ($($proc.Name))" -ForegroundColor DarkGray
        if (-not $proc.CommandLine) {
            Write-Host '    CommandLine not accessible (run PowerShell as admin).' -ForegroundColor DarkMagenta
            Write-Host ''
            continue
        }
        $args = @($proc.Arguments)
        if ($args.Count -eq 0) {
            Write-Host '    No relevant arguments found.' -ForegroundColor DarkGray
        } else {
            foreach ($arg in $args) {
                $color = Get-JvmArgSeverity -Arg $arg
                Write-Host "    $arg" -ForegroundColor $color
            }
        }
        Write-Host ''
    }
}

function Invoke-JvmScan {
    $results = [System.Collections.Generic.List[string]]::new()
    $seen = @{}

    function Add-JvmResult {
        param([string]$Message)
        if (-not $seen.ContainsKey($Message)) {
            $seen[$Message] = $true
            $results.Add($Message)
        }
    }

    try {
        $javaProcesses = @(Get-CimInstance Win32_Process -Filter "name = 'javaw.exe' OR name = 'java.exe'" -ErrorAction SilentlyContinue)
        foreach ($wmi in $javaProcesses) {
            $cmdLine = $wmi.CommandLine
            if (-not $cmdLine) { continue }

            # Handles both -javaagent:path.jar and -javaagent:"path with spaces.jar".
            $agentMatches = [regex]::Matches($cmdLine, '(?i)-javaagent:(?:"([^"]+)"|''([^'']+)''|([^\s]+))')
            foreach ($m in $agentMatches) {
                $agentPath = @($m.Groups[1].Value, $m.Groups[2].Value, $m.Groups[3].Value) | Where-Object { $_ } | Select-Object -First 1
                if (-not $agentPath) { continue }
                $agentName = [System.IO.Path]::GetFileName($agentPath)
                $legitAgents = @('jmxremote','yjp','jrebel','newrelic','jacoco','theseus')
                $isLegit = $false
                foreach ($la in $legitAgents) {
                    if ($agentName -match $la) { $isLegit = $true; break }
                }
                if (-not $isLegit) {
                    Add-JvmResult "JVM Agent — PID $($wmi.ProcessId): -javaagent:$agentName (path: $agentPath)"
                }
            }

            $suspiciousFlags = @(
                @{ Flag = '-Xbootclasspath/p:'; Desc = 'prepends to bootstrap classpath, overrides core Java classes' },
                @{ Flag = '-Xbootclasspath/a:'; Desc = 'appends entries to the bootstrap classpath' },
                @{ Flag = '-agentlib:jdwp';     Desc = 'JDWP debug agent, remote debugging enabled' },
                @{ Flag = '-agentpath:';        Desc = 'native agent loaded into the JVM' },
                @{ Flag = '-Djdk.attach.allowAttachSelf=true'; Desc = 'allows the JVM to attach an agent to itself' }
            )
            foreach ($sf in $suspiciousFlags) {
                if ($cmdLine.IndexOf($sf.Flag, [System.StringComparison]::OrdinalIgnoreCase) -ge 0) {
                    Add-JvmResult "Suspicious JVM flag — PID $($wmi.ProcessId): $($sf.Flag) ($($sf.Desc))"
                }
            }
        }
    } catch { }

    return $results
}

# --- Windows process/history checks ---
# These are intentionally separate from the JAR scan. They only report matching
# running processes or Windows Prefetch/Recent entries; they do not mark a JAR by themselves.
function Test-SuspiciousKeywordMatch {
    param(
        [string]$Text,
        [string]$Keyword
    )
    if ([string]::IsNullOrWhiteSpace($Text) -or [string]::IsNullOrWhiteSpace($Keyword)) { return $false }

    $textLower = $Text.ToLowerInvariant()
    $keywordLower = $Keyword.ToLowerInvariant().Trim()

    # Short/generic names use boundaries to avoid obvious false positives
    # (for example "Water" should not match "Waterfox").
    if ($keywordLower.Length -le 5) {
        $boundaryPattern = '(^|[^a-z0-9])' + [regex]::Escape($keywordLower) + '([^a-z0-9]|$)'
        return [regex]::IsMatch($textLower, $boundaryPattern)
    }

    if ($textLower.Contains($keywordLower)) { return $true }

    # Ignore common separators for names such as "Zenith Macros" / "Xenon V2".
    $normalizedText = [regex]::Replace($textLower, '[^a-z0-9]', '')
    $normalizedKeyword = [regex]::Replace($keywordLower, '[^a-z0-9]', '')
    return ($normalizedKeyword.Length -ge 6 -and $normalizedText.Contains($normalizedKeyword))
}

function Get-PrefetchLastRunFromBytes {
    param([byte[]]$Bytes)
    $validTimes = @()
    $now = Get-Date
    for ($i = 0; $i -le $Bytes.Length - 8; $i += 8) {
        $value = [BitConverter]::ToInt64($Bytes, $i)
        if ($value -le 0) { continue }
        try {
            $dt = [DateTime]::FromFileTimeUtc($value).ToLocalTime()
            if ($dt -ge (Get-Date '2000-01-01') -and $dt -le $now.AddDays(2)) {
                $validTimes += $dt
            }
        } catch { }
    }
    if ($validTimes.Count -gt 0) { return ($validTimes | Sort-Object)[-1] }
    return $null
}

function Get-PrefetchExePathFromBytes {
    param([byte[]]$Bytes)
    $patterns = @(
        '([A-Za-z]:\\[^\x00]+?\.exe)',
        '([A-Za-z]:\\[^\x00]+?\.EXE)'
    )
    $unicode = [System.Text.Encoding]::Unicode.GetString($Bytes)
    foreach ($pattern in $patterns) {
        $matches = [regex]::Matches($unicode, $pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
        if ($matches.Count -gt 0) { return $matches[$matches.Count - 1].Groups[1].Value.Trim() }
    }
    $ascii = [System.Text.Encoding]::ASCII.GetString($Bytes)
    foreach ($pattern in $patterns) {
        $matches = [regex]::Matches($ascii, $pattern, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
        if ($matches.Count -gt 0) { return $matches[$matches.Count - 1].Groups[1].Value.Trim() }
    }
    return $null
}

function Invoke-PrefetchScan {
    param(
        [string]$BasePath = "$env:SystemRoot\Prefetch",
        [string[]]$Keywords = @("198m","198macro","prestige","prestigeclient","prestigeinjector","doomsday","Boze","Dqrkis","BobertMacros","Orchard","Zenith Macros","Velaris","Karma","Pika","anamvmnt","Water","Noxx","Calcium","Zelith","Xenon V2","Echo")
    )
    $hits = [System.Collections.Generic.List[psobject]]::new()
    if (-not (Test-Path $BasePath)) { return $hits }
    foreach ($file in Get-ChildItem -Path $BasePath -Filter *.pf -ErrorAction SilentlyContinue) {
        $matched = $false
        foreach ($keyword in $Keywords) {
            if (Test-SuspiciousKeywordMatch -Text $file.Name -Keyword $keyword) { $matched = $true; break }
        }
        if (-not $matched) { continue }

        $bytes = Get-Content -Path $file.FullName -Encoding Byte -ErrorAction SilentlyContinue
        $exePath = Get-PrefetchExePathFromBytes -Bytes $bytes
        $lastRun = Get-PrefetchLastRunFromBytes -Bytes $bytes
        $hits.Add([PSCustomObject]@{
            FileName     = $file.Name
            PrefetchPath = $exePath
            LastRun      = $lastRun
            FilePath     = $file.FullName
        })
    }
    return $hits
}

function Invoke-RecentLnkScan {
    param(
        [string]$BasePath = "$env:APPDATA\Microsoft\Windows\Recent",
        [string[]]$Keywords = @("198m","198macro","prestige","prestigeclient","prestigeinjector","doomsday","novoware","Boze","Dqrkis","BobertMacros","Orchard","Zenith Macros","Velaris","Karma","Pika","anamvmnt","Water","Noxx","Calcium","Zelith","Xenon V2","Echo")
    )
    $hits = [System.Collections.Generic.List[psobject]]::new()
    if (-not (Test-Path $BasePath)) { return $hits }
    $shell = New-Object -ComObject WScript.Shell
    foreach ($link in Get-ChildItem -Path $BasePath -Filter *.lnk -ErrorAction SilentlyContinue) {
        try {
            $shortcut = $shell.CreateShortcut($link.FullName)
            $target = $shortcut.TargetPath
        } catch {
            $target = $null
        }
        $matched = $false
        foreach ($keyword in $Keywords) {
            if ((Test-SuspiciousKeywordMatch -Text $link.Name -Keyword $keyword) -or
                ($target -and (Test-SuspiciousKeywordMatch -Text $target -Keyword $keyword))) {
                $matched = $true
                break
            }
        }
        if (-not $matched) { continue }
        $hits.Add([PSCustomObject]@{
            FileName   = $link.Name
            TargetPath = $target
            LastUsed   = $link.LastAccessTime
            LinkPath   = $link.FullName
        })
    }
    return $hits
}

