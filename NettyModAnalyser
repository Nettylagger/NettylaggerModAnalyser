}

function Normalize-CurseForgeProjectPath {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return "" }

    $valueClean = $Value.Trim()
    if ($valueClean -match '(?i)/api/v1/mods/(\d+)(?:/|$)') { return $matches[1] }
    if ($valueClean -match '(?i)https?://(?:www\.)?curseforge\.com/(.+)$') { $valueClean = $matches[1] }
    $valueClean = ($valueClean -split '[?#]')[0].Trim('/')
    $valueClean = $valueClean -replace '(?i)/files(?:/.*)?$', ''
    $valueClean = $valueClean -replace '(?i)/download(?:/.*)?$', ''
    return $valueClean.Trim('/')
}

function Get-CurseForgeProjectPathFromData {
    param($Data)
    $json = Convert-ObjectToCompactJson -Data $Data
    if (-not $json) { return "" }

    if ($json -match '(?i)https?://(?:www\.)?curseforge\.com/([^"\\]+)') {
        return (Normalize-CurseForgeProjectPath -Value ("https://www.curseforge.com/" + $matches[1]))
    }
    if ($json -match '(?i)"(?:curseforgeId|curseforge_id|cfId|cf_id)"\s*:\s*"?(\d+)"?') {
        return $matches[1]
    }
    if ($json -match '(?i)"(?:curseforgeSlug|curseforge_slug|cfSlug|cf_slug)"\s*:\s*"([^"\\]+)"') {
        return "minecraft/mc-mods/$($matches[1])"
    }
    return ""
}

function Query-CurseForgeByProjectPath {
    param([string]$ProjectPath)

    $normalized = Normalize-CurseForgeProjectPath -Value $ProjectPath
    if ([string]::IsNullOrWhiteSpace($normalized)) { return $null }

    try {
        $encodedPath = (($normalized -split '/') | ForEach-Object { [uri]::EscapeDataString($_) }) -join '/'
        $info = Invoke-RestMethod -Uri "https://api.cfwidget.com/$encodedPath" -Method Get -UseBasicParsing -ErrorAction Stop
        $count = -1
        if ($null -ne $info.downloads -and $null -ne $info.downloads.total) {
            $count = [long]$info.downloads.total
        } elseif ($null -ne $info.downloadCount) {
            $count = [long]$info.downloadCount
        }

        if ($count -ge 0) {
            $title = if ($info.title) { $info.title } elseif ($info.name) { $info.name } else { "" }
            return @{
                Name = $title
                Downloads = $count
                DownloadSource = "CurseForge"
                ProjectPath = $normalized
            }
        }
    } catch { }

    return $null
}

function Get-MegabaseStoredDownloadInfo {
    param($Data)
    $json = Convert-ObjectToCompactJson -Data $Data
    if (-not $json) { return $null }

    $patterns = @(
        @{ Source = 'Modrinth'; Regex = '(?i)"(?:modrinthDownloads|modrinth_downloads)"\s*:\s*(\d+)' },
        @{ Source = 'CurseForge'; Regex = '(?i)"(?:curseforgeDownloads|curseforge_downloads|cfDownloads|cf_downloads)"\s*:\s*(\d+)' }
