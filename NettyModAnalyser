function Invoke-HistoryArtifactPathScan {
    param(
        [string[]]$Paths = @(
            (Join-Path $env:LOCALAPPDATA 'Temp\cracke2_bypass\.minecraft\.mcClient-renderer-cache')
        )
    )

    $hits = [System.Collections.Generic.List[psobject]]::new()
    foreach ($path in $Paths) {
        if ([string]::IsNullOrWhiteSpace($path)) { continue }
        if (-not (Test-Path -LiteralPath $path -PathType Container)) { continue }

        $folder = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
        $renderJson = Join-Path $path 'render.json'
        $evidence = if (Test-Path -LiteralPath $renderJson -PathType Leaf) {
            Get-Item -LiteralPath $renderJson -Force -ErrorAction SilentlyContinue
        } else {
            $folder
        }
        if (-not $evidence) { continue }

        $age = (Get-Date) - $evidence.LastWriteTime
        $daysAgo = [Math]::Max(0, [Math]::Floor($age.TotalDays))
        $hits.Add([PSCustomObject]@{
            Artifact = 'Dqrkis External Config Found'
            Path     = $evidence.FullName
            Created  = $evidence.CreationTime
            Modified = $evidence.LastWriteTime
            LastUsed = $evidence.LastWriteTime
            DaysAgo  = [int]$daysAgo
            Kind     = 'Config'
        })
    }
    # Persistent WebView evidence: BrowserMetrics contains the internal executable name.
    $webViewRoot = Join-Path $env:LOCALAPPDATA 'com.windows.coreruntime\EBWebView'
    $browserMetricsRoot = Join-Path $webViewRoot 'BrowserMetrics'
    if (Test-Path -LiteralPath $browserMetricsRoot -PathType Container) {
        $metricMatches = @(Get-ChildItem -LiteralPath $browserMetricsRoot -Filter 'BrowserMetrics-*' -File -Force -ErrorAction SilentlyContinue | Where-Object {
            try {
                $content = [Text.Encoding]::ASCII.GetString([IO.File]::ReadAllBytes($_.FullName))
                $content.IndexOf('dqrkis.exe', [StringComparison]::OrdinalIgnoreCase) -ge 0
            } catch { $false }
        } | Sort-Object LastWriteTime -Descending)
        if ($metricMatches.Count -gt 0) {
            $evidence = $metricMatches[0]
            $daysAgo = [Math]::Max(0, [Math]::Floor(((Get-Date) - $evidence.LastWriteTime).TotalDays))
            $hits.Add([PSCustomObject]@{
                Artifact = 'Dqrkis BrowserMetrics Found'
                Path = $evidence.FullName
                Created = $evidence.CreationTime
                Modified = $evidence.LastWriteTime
                LastUsed = $evidence.LastWriteTime
                DaysAgo = [int]$daysAgo
                Kind = 'Config'
            })
        }
    }

    # Persistent WebView evidence: Local Storage contains the Dqrkis-specific key.
    $levelDbRoot = Join-Path $webViewRoot 'Default\Local Storage\leveldb'
    if (Test-Path -LiteralPath $levelDbRoot -PathType Container) {
        $storageMatches = @(Get-ChildItem -LiteralPath $levelDbRoot -File -Force -ErrorAction SilentlyContinue | Where-Object {
            try {
                $content = [Text.Encoding]::ASCII.GetString([IO.File]::ReadAllBytes($_.FullName))
                $content.IndexOf('dqrkis_saved_key', [StringComparison]::OrdinalIgnoreCase) -ge 0
            } catch { $false }
        } | Sort-Object LastWriteTime -Descending)
        if ($storageMatches.Count -gt 0) {
            $evidence = $storageMatches[0]
            $daysAgo = [Math]::Max(0, [Math]::Floor(((Get-Date) - $evidence.LastWriteTime).TotalDays))
            $hits.Add([PSCustomObject]@{
                Artifact = 'Dqrkis Local Storage Found'
                Path = $evidence.FullName
                Created = $evidence.CreationTime
                Modified = $evidence.LastWriteTime
                LastUsed = $evidence.LastWriteTime
                DaysAgo = [int]$daysAgo
                Kind = 'Config'
            })
        }
    }

    # MUICache preserves the internal Dqrkis path and display name after renaming/closing.
    $muiKeys = @(
        'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache',
        'HKCU:\Software\Microsoft\Windows\ShellNoRoam\MUICache'
    )
    $muiFound = $false
    foreach ($muiKey in $muiKeys) {
        if ($muiFound -or -not (Test-Path -LiteralPath $muiKey)) { continue }
        try {
            $muiData = Get-ItemProperty -LiteralPath $muiKey -ErrorAction Stop
            foreach ($property in $muiData.PSObject.Properties) {
                if ($property.Name -match '(?i)dqrkis\.exe\.FriendlyAppName$') {
                    $hits.Add([PSCustomObject]@{
                        Artifact = 'Dqrkis MUICache Entry Found'
                        Path = $property.Name
                        Application = [string]$property.Value
                        Created = $null
                        Modified = $null
                        LastUsed = $null
                        DaysAgo = $null
                        Kind = 'Registry'
                    })
                    $muiFound = $true
                    break
                }
            }
        } catch { }
    }

    # Windows PCA Event 17 records actual execution and survives process exit.
    try {
        $pcaEvents = @(Get-WinEvent -FilterHashtable @{
            LogName = 'Microsoft-Windows-Application-Experience/Program-Compatibility-Assistant'
            Id = 17
        } -ErrorAction Stop | Where-Object {
            $_.Message -match '(?i)\\cracke2_bypass\\dqrkis\.exe|\\dqrkis\.exe'
        } | Sort-Object TimeCreated -Descending)

        if ($pcaEvents.Count -gt 0) {
            $event = $pcaEvents[0]
            $pathMatch = [regex]::Match($event.Message, '(?im)([A-Z]:\\[^\r\n]*?dqrkis\.exe)')
            $executionPath = if ($pathMatch.Success) { $pathMatch.Groups[1].Value.Trim() } else { 'dqrkis.exe' }
            $daysAgo = [Math]::Max(0, [Math]::Floor(((Get-Date) - $event.TimeCreated).TotalDays))
            $hits.Add([PSCustomObject]@{
                Artifact = 'Dqrkis PCA Execution Event Found'
                Path = $executionPath
                Application = 'Event ID 17'
                Created = $event.TimeCreated
                Modified = $event.TimeCreated
                LastUsed = $event.TimeCreated
                DaysAgo = [int]$daysAgo
                Kind = 'Config'
            })
        }
    } catch { }

    return $hits
}

