function Write-HiddenBadge {
    param([System.IO.FileSystemInfo]$File)
    if ($File.Attributes -band [System.IO.FileAttributes]::Hidden) {
        Write-Host " [MOD IS HIDDEN]" -ForegroundColor Yellow -NoNewline
    }
}

function Test-IsHiddenPath {
    param(
        [System.IO.FileSystemInfo]$File,
        [string]$RootPath
    )

    try {
        $rootItem = Get-Item -LiteralPath $RootPath -Force -ErrorAction Stop
        $rootFull = $rootItem.FullName.TrimEnd([char[]]"\/")
        $item = $File

        while ($null -ne $item) {
            if (($item.Attributes -band [System.IO.FileAttributes]::Hidden) -ne 0) {
                return $true
            }

            $itemFull = $item.FullName.TrimEnd([char[]]"\/")
            if ($itemFull -ieq $rootFull) { break }
            $item = $item.Parent
        }
    } catch {
        return (($File.Attributes -band [System.IO.FileAttributes]::Hidden) -ne 0)
    }

    return $false
}

